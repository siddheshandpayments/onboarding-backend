# --- App ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboarding?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- TOTP ---
TOTP_ISSUER="Onboarding Platform"

# --- Login identity domains ---
# Synthetic temp-login-email domain (never a real, deliverable address).
LOGIN_EMAIL_DOMAIN="id.onboarding.internal"
# Real company email domain — auto-generated as name@COMPANY_EMAIL_DOMAIN
# (name1@, name2@, ... on collision) when HR provisions a company email.
COMPANY_EMAIL_DOMAIN="example.com"

# --- SMTP (Nodemailer) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@example.com"
SMTP_PASS="change-me"
SMTP_FROM="Onboarding Platform <no-reply@example.com>"
